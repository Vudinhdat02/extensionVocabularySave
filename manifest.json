{
  "manifest_version": 3,
  "name": "Auto Vocab Saver",
  "version": "1.1.0",
  "description": "Tự động lưu từ vựng khi sao chép",
  "permissions": [
    "storage"
  ],
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
